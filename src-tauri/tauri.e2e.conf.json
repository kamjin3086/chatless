{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.kamjin.chatless.e2e",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chatless E2E",
        "width": 900,
        "height": 700,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0f172a",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --remote-debugging-port=0"
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false
  }
}
