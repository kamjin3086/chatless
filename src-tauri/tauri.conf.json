{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chatless",
  "version": "0.7.1",
  "identifier": "com.kamjin.chatless",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chatless",
        "width": 900,
        "height": 700,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "closable": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0f172a",
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' http://localhost:* http://127.0.0.1:* https: http: ws: wss:; font-src 'self' data:; media-src 'self' blob:; frame-src 'self'",
      "capabilities": [
        "main-capability"
      ]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxMDAzMUQ1MUNFRjVCNEYKUldSUFcrOGMxVEVBOFVpR0hNMGtlbEZZbzZSYTFIclJzdzJsUXgxd3paK1pVYlFnSEoyWWk2QmUK",
      "endpoints": [
        "https://gh-proxy.org/https://github.com/kamjin3086/chatless/releases/latest/download/update-proxy.json",
        "https://github.com/kamjin3086/chatless/releases/latest/download/update.json",
        "https://gh-proxy.org/https://github.com/kamjin3086/chatless/releases/download/updater-alpha/update-proxy.json",
        "https://github.com/kamjin3086/chatless/releases/download/updater-alpha/update.json"
      ]
    },
    "store": null,
    "sql": {
      "enabled": true,
      "drivers": [
        "sqlite"
      ],
      "preload": [
        "sqlite:mychat.db"
      ]
    },
    "http": null,
    "opener": null,
    "dialog": null
  }
}
