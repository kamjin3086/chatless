<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    The bundled ONNX Runtime (libonnxruntime.dylib) ships with an upstream
    linker-signed ad-hoc signature and has no TeamIdentifier. With the
    hardened runtime enabled, library validation refuses to dlopen it
    ("mapping process and mapped file (non-platform) have different Team IDs"),
    which silently disables on-device embeddings. This entitlement keeps the
    hardened runtime for the app itself while allowing the bundled dylib to
    load.
  -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
