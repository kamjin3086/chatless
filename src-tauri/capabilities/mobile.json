{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-capability",
  "description": "Experimental mobile chat: app-private storage and provider networking only",
  "platforms": ["android"],
  "windows": ["main"],
  "permissions": [
    "core:default", "sql:default", "sql:allow-execute", "core:path:default",
    "fs:default", "fs:allow-exists", "fs:allow-mkdir",
    "fs:allow-read-text-file", "fs:allow-write-text-file",
    "fs:scope-appconfig", "fs:allow-appconfig-read-recursive", "fs:allow-appconfig-write-recursive",
    { "identifier": "fs:scope", "allow": [{"path": "$APPDATA"}, {"path": "$APPDATA/**/*"}, {"path": "$APPLOG"}, {"path": "$APPLOG/**/*"}] },
    { "identifier": "http:default", "allow": [{"url": "https://*"}, {"url": "http://localhost:*"}, {"url": "http://127.0.0.1:*"}] },
    "store:default", "opener:default", "dialog:default",
    "log:default", "log:allow-log", "os:default"
  ]
}
