#!/usr/bin/env bash
# Fast pre-commit guardrail for this clone. Wired by `pnpm install` (the
# `prepare` script sets core.hooksPath=.githooks, a value stored in this
# clone's .git/config only - it changes nothing global).
#
# Budget: a handful of seconds. These are the checks this repo had no local
# guardrail for at all; everything used to be CI-only:
#   1. conflict markers in staged content
#   2. formatting on exactly the staged files, and only where HEAD already conformed
#      (one biome call per dirty staged file, ~0.2s each, so the cost scales with what you
#      staged rather than with the tree)
#   3. typecheck of production code (`pnpm typecheck`, about 5s). Test types live in
#      `pnpm typecheck:tests`, run by `pnpm verify` and CI; keeping them out of the hook is
#      what keeps the hook fast.
# Anything slower stays CI's job: `pnpm verify` (lint:ci + typecheck + build) is
# still the bar before pushing. See docs/agents/maintenance.md.
#
# Skip once with:  git commit --no-verify

set -uo pipefail
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0
report() { printf 'pre-commit: %s\n' "$1"; }

# 1. conflict markers
marked=""
while IFS= read -r file; do
  [ -n "$file" ] || continue
  # Judge the index, because the index is what git is about to commit - a working-tree
  # grep would pass a staged conflict and fail a clean one.
  if git show ":$file" 2>/dev/null | grep -qE '^(<<<<<<< |>>>>>>>)'; then
    marked="$marked $file"
  fi
done <<< "$staged"
if [ -n "$marked" ]; then
  report "conflict markers in:$marked"
  fail=1
fi

# 2a. a comment that names a symbol promises that symbol exists. Cheap: one grep per name,
# and only the names in files you staged. See scripts/comment-symbols.mjs.
# exit 0 clean, 1 a stale promise (the author's to fix), 2 the check could not run - which is
# reported and let through, because blocking a commit for a missing grep teaches --no-verify.
# xargs turns any child failure into 123, which would make a real finding look like a broken
# check - so read the names here and keep the exit code the script actually returned.
staged_files=()
while IFS= read -r -d '' f; do staged_files+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACM -z)
if [ ${#staged_files[@]} -gt 0 ] && ! node scripts/comment-symbols.mjs "${staged_files[@]}"; then
  case $? in
    1) report "a comment names a symbol that no longer exists - fix the comment or restore the symbol"; fail=1 ;;
    *) report "comment symbol check could not run; nothing was concluded" ;;
  esac
fi

# 2. formatting, judged per file: a file already unformatted at HEAD is not this change's
# business to reflow - that is how a change commit turns into 2,000 lines of churn, and the
# reason `--no-verify` was getting used. See scripts/format-policy.mjs.
if ! node scripts/format-policy.mjs --staged > /tmp/chatless-precommit-biome.log 2>&1; then
  report "staged files introduced formatting dirt - run: pnpm fmt <the files>"
  sed -n '1,12p' /tmp/chatless-precommit-biome.log
  fail=1
fi

# 3. types
if [ -f tsconfig.json ] && ! npx tsc -p tsconfig.json --noEmit > /tmp/chatless-precommit-tsc.log 2>&1; then
  report "typecheck failed - run: pnpm typecheck"
  sed -n '1,10p' /tmp/chatless-precommit-tsc.log
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  report "commit blocked ($(printf '%s\n' "$staged" | wc -l | tr -d ' ') files staged)"
  exit 1
fi
